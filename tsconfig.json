{
  "include": ["./src/**/*", "tests/helper.ts"],
  "exclude": [
    "**/*.spec.ts",
    "dist",
    "node_modules",
    "example/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "lib": ["es6"],
    "declaration": true,
    "moduleResolution": "bundler", // typescript-eslint 8.56+ only exposes some type subpaths via package.json "exports", which node10 resolution ignores
    "baseUrl": ".",
    "target": "es6",
    "module": "es6",
    "outDir": "dist",
    "allowSyntheticDefaultImports": true
  }
}
