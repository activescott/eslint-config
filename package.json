{
  "name": "@activescott/eslint-config",
  "version": "0.0.0",
  "description": "An ESLint sharable config for TypeScript.",
  "author": "Scott Willeke <scott@willeke.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activescott/eslint-config.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/config.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rm -rfd ./dist && tsc",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "all": "npm run build && npm run lint && npm run test",
    "dev": "jest --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "eslint": "^10.4.0",
    "eslint-plugin-jest": "^29.13.0",
    "eslint-plugin-prettier": "^5.2.1",
    "typescript-eslint": "^8.56.0",
    "eslint-plugin-unicorn": "^79.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^79.0.0",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
